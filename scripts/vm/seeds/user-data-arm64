#cloud-config
hostname: wardrobe-build-arm64
manage_etc_hosts: true
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ08K8iV0SPTZcgVsFwtu7TIJhk5h7Zh/AFbDIvf+F57 wardrobe-build-vm
ssh_pwauth: false
growpart:
  mode: auto
  devices: ['/']
apt:
  primary:
    - arches: [default]
      uri: http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
package_update: true
package_upgrade: false
packages:
  - build-essential
  - pkg-config
  - cmake
  - ninja-build
  - git
  - curl
  - wget
  - rsync
  - python3
  - file
  - libssl-dev
  - libdbus-1-dev
  - libxdo-dev
  - librsvg2-dev
  - libayatana-appindicator3-dev
  - libwebkit2gtk-4.1-dev
  - libgtk-3-dev
  - gnome-keyring
  - dbus-x11
  - libfuse2t64
  - dpkg-dev
  - curl
runcmd:
  - curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh
  - runuser -u ubuntu -- sh /tmp/rustup-init.sh -y --default-toolchain stable --profile minimal
  - runuser -u ubuntu -- bash -lc 'curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - && sudo apt-get install -y nodejs' || echo "nodesource failed; CLI-only build still viable"
