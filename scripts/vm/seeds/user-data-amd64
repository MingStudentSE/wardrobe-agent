#cloud-config
hostname: wardrobe-bench-amd64
manage_etc_hosts: true
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ08K8iV0SPTZcgVsFwtu7TIJhk5h7Zh/AFbDIvf+F57 wardrobe-build-vm
ssh_pwauth: false
growpart:
  mode: auto
  devices: ['/']
apt:
  primary:
    - arches: [default]
      uri: http://mirrors.tuna.tsinghua.edu.cn/ubuntu
package_update: true
package_upgrade: false
packages:
  - build-essential
  - pkg-config
  - git
  - curl
  - rsync
  - python3
  - file
  - libssl-dev
  - patchelf
  - dpkg-dev
runcmd:
  - curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh
  - runuser -u ubuntu -- sh /tmp/rustup-init.sh -y --default-toolchain stable --profile minimal
